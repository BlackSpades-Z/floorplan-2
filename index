// ── DINING AREA (bucket-chair tables in front of food court) ──
function bucketDiningSet(cx, cz, decorType) {
  const chairH = 0.75;
  const chairR = 0.45;
  const seatY = 0.55;
  const tableR = 0.95;
  const tableY = 0.9;
  const tableTopH = 0.08;
  const chairDist = 2.1;

  // ── TABLE — medium oak top on brass-detailed pedestal-splayed base ──
  cyl(tableR, tableTopH, walnut(WOOD_DARK), cx, tableY+tableTopH/2, cz, gf);
  cyl(tableR-0.05, 0.03, brass(), cx, tableY-0.005, cz, gf);
  // 4 slim walnut splayed legs
  for (let i = 0; i < 4; i++) {
    const legAng = i * PI/2 + PI/4;
    const legTopR = 0.05;
    const legBotR = 0.35;
    const legTX = cx + legTopR * Math.cos(legAng);
    const legTZ = cz + legTopR * Math.sin(legAng);
    const legBX = cx + legBotR * Math.cos(legAng);
    const legBZ = cz + legBotR * Math.sin(legAng);
    const dx = legBX - legTX, dz = legBZ - legTZ;
    const legLenXZ = Math.sqrt(dx*dx + dz*dz);
    const legLenTotal = Math.sqrt(legLenXZ*legLenXZ + tableY*tableY);
    const leg = new THREE.Mesh(
      new THREE.CylinderGeometry(0.03, 0.03, legLenTotal, 8),
      walnut(WOOD_DARK)
    );
    leg.position.set((legTX+legBX)/2, tableY/2, (legTZ+legBZ)/2);
    const tiltAngle = Math.atan2(legLenXZ, tableY);
    leg.rotation.order = 'YXZ';
    leg.rotation.y = -legAng;
    leg.rotation.x = tiltAngle;
    leg.castShadow = true; leg.receiveShadow = true;
    gf.add(leg);
  }

  // ── TABLE DECOR (varies per table) ──
  const tableTopY = tableY + tableTopH + 0.02;
  if (decorType === 'coffee') {
    // Two coffee cups + a small plate
    cyl(0.11, 0.12, ceramic(0xEFE6D2), cx-0.3, tableTopY+0.06, cz-0.2, gf);
    cyl(0.08, 0.02, clay(0x3E2A1C), cx-0.3, tableTopY+0.11, cz-0.2, gf);
    cyl(0.11, 0.12, ceramic(0xE0D6C0), cx+0.25, tableTopY+0.06, cz+0.25, gf);
    cyl(0.08, 0.02, clay(0x3E2A1C), cx+0.25, tableTopY+0.11, cz+0.25, gf);
    cyl(0.18, 0.02, ceramic(0xE8DED0), cx+0.1, tableTopY+0.01, cz-0.3, gf);
  } else if (decorType === 'vase') {
    // Small ceramic vase with sprig
    cyl(0.1, 0.28, ceramic(0xC9BFA8), cx, tableTopY+0.14, cz, gf);
    cyl(0.02, 0.4, walnut(WOOD_MED), cx, tableTopY+0.42, cz, gf);
    const leaf = new THREE.Mesh(new THREE.SphereGeometry(0.09, 6, 5), clay(0x7A8A66));
    leaf.position.set(cx, tableTopY+0.58, cz); leaf.scale.set(1,1.4,0.6);
    leaf.castShadow = true; gf.add(leaf);
  } else if (decorType === 'book') {
    // Small stack of books
    box(0.55, 0.06, 0.42, linen(0xE8DED0), cx-0.1, tableTopY+0.03, cz+0.15, gf);
    box(0.5, 0.05, 0.38, linen(0xD4C7AE), cx-0.05, tableTopY+0.085, cz+0.15, gf);
    // Coffee cup nearby
    cyl(0.11, 0.12, ceramic(0xEFE6D2), cx+0.35, tableTopY+0.06, cz-0.15, gf);
    cyl(0.08, 0.02, clay(0x3E2A1C), cx+0.35, tableTopY+0.11, cz-0.15, gf);
  } else if (decorType === 'candle') {
    // Ceramic candle holder + small dish
    cyl(0.09, 0.18, ceramic(0xEFE6D2), cx, tableTopY+0.09, cz, gf);
    cyl(0.025, 0.06, clay(0x6E5E4E), cx, tableTopY+0.21, cz, gf);
    cyl(0.16, 0.02, ceramic(0xC9BFA8), cx+0.25, tableTopY+0.01, cz+0.2, gf);
  } else {
    // Default: single ceramic bowl
    cyl(0.18, 0.08, ceramic(0xE0D6C0), cx, tableTopY+0.04, cz, gf);
    cyl(0.14, 0.02, ceramic(0xD4C8B4), cx, tableTopY+0.08, cz, gf);
  }

  // ── 4 CHAIRS around the table (facing INWARD toward the table) ──
  for (let i = 0; i < 4; i++) {
    const ang = i * PI/2;
    const chX = cx + chairDist * Math.cos(ang);
    const chZ = cz + chairDist * Math.sin(ang);

    const shellOuter = new THREE.Mesh(
      new THREE.CylinderGeometry(chairR, chairR, chairH, 20, 1, false, 0, PI),
      linen(0xE8DECE)
    );
    shellOuter.position.set(chX, seatY + chairH/2 - 0.15, chZ);
    shellOuter.rotation.y = -ang - PI/2;
    shellOuter.castShadow = true; shellOuter.receiveShadow = true;
    gf.add(shellOuter);

    // Seat cushion
    cyl(chairR-0.08, 0.1, linen(0xD4C7AE), chX, seatY, chZ, gf);

    // 4 slim splayed walnut chair legs
    for (let j = 0; j < 4; j++) {
      const legAng2 = j * PI/2 + PI/4;
      const legTX2 = chX + 0.08 * Math.cos(legAng2);
      const legTZ2 = chZ + 0.08 * Math.sin(legAng2);
      const legBX2 = chX + 0.32 * Math.cos(legAng2);
      const legBZ2 = chZ + 0.32 * Math.sin(legAng2);
      const dxc = legBX2 - legTX2, dzc = legBZ2 - legTZ2;
      const legLenXZc = Math.sqrt(dxc*dxc + dzc*dzc);
      const legLenTotalC = Math.sqrt(legLenXZc*legLenXZc + seatY*seatY);
      const legC = new THREE.Mesh(
        new THREE.CylinderGeometry(0.025, 0.025, legLenTotalC, 8),
        walnut(WOOD_DARK)
      );
      legC.position.set((legTX2+legBX2)/2, seatY/2, (legTZ2+legBZ2)/2);
      const tiltAngleC = Math.atan2(legLenXZc, seatY);
      legC.rotation.order = 'YXZ';
      legC.rotation.y = -legAng2;
      legC.rotation.x = tiltAngleC;
      legC.castShadow = true; legC.receiveShadow = true;
      gf.add(legC);
    }
  }
}

