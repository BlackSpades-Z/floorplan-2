// Artificial turf — clean mow stripes only. No noise, no gradient, no grunge.
// Muted sage-green so it sits inside the calm palette instead of shouting.
function makeTurfTexture() {
  const c = document.createElement('canvas');
  c.width = 512; c.height = 512;
  const g = c.getContext('2d');
  const stripes = 12;
  const h = 512 / stripes;
  for (let i = 0; i < stripes; i++) {
    g.fillStyle = i % 2 === 0 ? '#8CA36A' : '#94AB74';   // muted, calm, Scandinavian green
    g.fillRect(0, i * h, 512, h);
  }
  const tex = new THREE.CanvasTexture(c);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(1, 1);
  tex.anisotropy = 8;
  return tex;
}
const turfMat = new THREE.MeshStandardMaterial({
  map: makeTurfTexture(), roughness: 0.95, metalness: 0, envMapIntensity: 0.2
});
const turfSurface = box(turfW, 0.08, turfD - WT, turfMat,
