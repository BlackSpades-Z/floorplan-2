// ORBIT CONTROLS
// ═══════════════════════════════════════════════════════
let isDown=false, btn=0, pX=0, pY=0;
let sph = new THREE.Spherical();
let orbitTarget = new THREE.Vector3(0,0,0);

function updateSph(){sph.setFromVector3(camera.position.clone().sub(orbitTarget))}
updateSph();

canvas.addEventListener('pointerdown',e=>{
  isDown=true; btn=e.button; pX=e.clientX; pY=e.clientY;
  canvas.setPointerCapture(e.pointerId);
});
canvas.addEventListener('pointermove',e=>{
  if(!isDown)return;
  const dx=e.clientX-pX, dy=e.clientY-pY;
  pX=e.clientX; pY=e.clientY;

  if(btn===2||e.shiftKey){
    const panScale = sph.radius * 0.012;
    const forward = new THREE.Vector3();
    camera.getWorldDirection(forward);
    forward.y=0; forward.normalize();
    const right = new THREE.Vector3().crossVectors(new THREE.Vector3(0,1,0), forward).normalize();
    orbitTarget.add(right.multiplyScalar(dx*panScale));
    orbitTarget.add(forward.multiplyScalar(-dy*panScale));
    camera.position.copy(orbitTarget).add(new THREE.Vector3().setFromSpherical(sph));
    camera.lookAt(orbitTarget);
  } else {
    updateSph();
    sph.theta -= dx*0.006;
    sph.phi -= dy*0.006;
    sph.phi = Math.max(0.15, Math.min(PI/2-0.05, sph.phi));
    camera.position.copy(orbitTarget).add(new THREE.Vector3().setFromSpherical(sph));
    camera.lookAt(orbitTarget);
  }
});
canvas.addEventListener('pointerup',()=>isDown=false);
canvas.addEventListener('contextmenu',e=>e.preventDefault());
canvas.addEventListener('wheel',e=>{
  e.preventDefault(); updateSph();
  sph.radius *= 1+e.deltaY*0.001;
