// ═══════════════════════════════════════════════════════
// ORBIT CONTROLS
// ═══════════════════════════════════════════════════════
let isDown=false, btn=0, pX=0, pY=0;
let sph = new THREE.Spherical();
let orbitTarget = new THREE.Vector3(0,0,0);

function updateSph(){sph.setFromVector3(camera.position.clone().sub(orbitTarget))}
updateSph();

canvas.addEventListener('pointerdown',e=>{
  isDown=true; btn=e.button; pX=e.clientX; pY=e.clientY;
  canvas.setPointerCapture(e.pointerId);
});
canvas.addEventListener('pointermove',e=>{
  if(!isDown)return;
  const dx=e.clientX-pX, dy=e.clientY-pY;
  pX=e.clientX; pY=e.clientY;

  if(btn===2||e.shiftKey){
    const panScale = sph.radius * 0.012;
    const forward = new THREE.Vector3();
    camera.getWorldDirection(forward);
    forward.y=0; forward.normalize();
    const right = new THREE.Vector3().crossVectors(new THREE.Vector3(0,1,0), forward).normalize();
    orbitTarget.add(right.multiplyScalar(dx*panScale));
    orbitTarget.add(forward.multiplyScalar(-dy*panScale));
    camera.position.copy(orbitTarget).add(new THREE.Vector3().setFromSpherical(sph));
    camera.lookAt(orbitTarget);
  } else {
    updateSph();
    sph.theta -= dx*0.006;
    sph.phi -= dy*0.006;
    sph.phi = Math.max(0.15, Math.min(PI/2-0.05, sph.phi));
    camera.position.copy(orbitTarget).add(new THREE.Vector3().setFromSpherical(sph));
    camera.lookAt(orbitTarget);
  }
});
canvas.addEventListener('pointerup',()=>isDown=false);
canvas.addEventListener('contextmenu',e=>e.preventDefault());
canvas.addEventListener('wheel',e=>{
  e.preventDefault(); updateSph();
  sph.radius *= 1+e.deltaY*0.001;
  sph.radius = Math.max(20, Math.min(150, sph.radius));
  camera.position.copy(orbitTarget).add(new THREE.Vector3().setFromSpherical(sph));
  camera.lookAt(orbitTarget);
},{passive:false});

window.addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});

// ── Reference light aliases for the focus mode animation ──
const ambientLight = scene.children.find(c => c.isAmbientLight);
const sunLight     = sun;
const fillLight    = skyFill;
const hemiLight    = scene.children.find(c => c.isHemisphereLight);

// ═══════════════════════════════════════════════════════
// CINEMATIC ZOOM-TO-ZONE SYSTEM
// ═══════════════════════════════════════════════════════

const defaultCameraPos = new THREE.Vector3(46.5, 46.5, 46.5);  // dollied in ~18% — same angle, same FOV
const defaultLookAt    = new THREE.Vector3(0, 0, 0);

// Original baseline light intensities (for restore)
const originalLights = {
  ambient: 0.42,
  sun: 2.05,
  fill: 0.42,
  hemi: 0.58
};

// Zone camera presets — position, look-at, spot target, panel copy
const zonePresets = {
  turf: {
    cameraPos:  new THREE.Vector3(0, 30, 12),
    lookAt:     new THREE.Vector3(0, 1, -20),
    spotTarget: new THREE.Vector3(0, 0, -20),
    spotAngle: PI/3,      // wider — turf is the biggest zone
    title: 'Turf Area',
    text: 'Movement, sport, play — a soft synthetic-turf field for casual games and daily physical activity.'
  },
  snackbar: {
    cameraPos:  new THREE.Vector3(4, 10, 6),
    lookAt:     new THREE.Vector3(19, 1.5, 2.5),
    spotTarget: new THREE.Vector3(19, 0, 2.5),
    title: 'Snack Bar',
    text: 'Quick bites, coffee and energy drinks — refuel between sessions without leaving the space.'
  },
  privateA: {
    cameraPos:  new THREE.Vector3(-6, 18, 12),
    lookAt:     new THREE.Vector3(11, 1, 20),
    spotTarget: new THREE.Vector3(11, 0, 20),
    spotAngle: PI/4,
    title: 'Private Room A',
    text: 'Bookable studio for workshops, group therapy, and small classes — a quiet space that adapts to the moment.'
  },
  privateB: {
    // RECOMPOSED. The old shot sat low and oblique outside the room, so the front wall
    // filled half the frame. The sofa (west wall) and TV (east wall) face each other
    // across the room, so the only viewpoint that holds both is square-on from the south.
    // Raised to y=12 and pulled back to z=40: the camera now looks OVER the front wall
    // (its top edge drops to ~19% of frame height, acting purely as a bottom framing
    // edge) and down INTO the room. Sofa reads left, coffee table + bean bags centre,
    // TV right. Slight west offset keeps it a three-quarter rather than a flat elevation.
    cameraPos:  new THREE.Vector3(-20, 12, 40),
    lookAt:     new THREE.Vector3(-16, 1.6, 25),
    spotTarget: new THREE.Vector3(-16, 0, 25),
    title: 'Private Room B',
    text: 'Smaller bookable room for one-on-ones, meditation, or a quiet solo session.'
  }
};

// ── Focus spotlight (soft wide cone) ──
const zoneSpot = new THREE.SpotLight(0xFFFAF0, 0, 45, PI/3.5, 0.92, 1.4);
zoneSpot.position.set(0, 25, 0);
zoneSpot.castShadow = false;
scene.add(zoneSpot);
scene.add(zoneSpot.target);

const BASE_EXPOSURE  = 1.05;
const FOCUS_EXPOSURE = 1.05;
const FOCUS_DURATION = 950;

// ── Invisible click-catcher hit zones ──
const zoneHitZones = [
  { id: 'turf',     center: new THREE.Vector3(0,   0, -20), radius: 22 },
  { id: 'snackbar', center: new THREE.Vector3(19,  0, 2.5), radius: 7 },
  { id: 'privateA', center: new THREE.Vector3(11,  0, 20),  radius: 13 },
  { id: 'privateB', center: new THREE.Vector3(-16, 0, 25),  radius: 9 }
];

// ── Animation state ──
let anim = null;
let currentZone = null;

function easeInOutCubic(t) {
  // Retained name; now a quintic ease — heavier settle for architectural-walkthrough pacing.
  return t < 0.5 ? 16*t*t*t*t*t : 1 - Math.pow(-2*t + 2, 5)/2;
}

function startAnim(from, to, duration, onComplete) {
  anim = { start: performance.now(), duration, from, to, onComplete };
}

function updateAnim() {
  if (!anim) return;
  const now = performance.now();
  const t = Math.min(1, (now - anim.start) / anim.duration);
  const e = easeInOutCubic(t);

  camera.position.lerpVectors(anim.from.cameraPos, anim.to.cameraPos, e);
  orbitTarget.lerpVectors(anim.from.lookAt, anim.to.lookAt, e);
  camera.lookAt(orbitTarget);

  if (ambientLight) ambientLight.intensity = anim.from.ambient + (anim.to.ambient - anim.from.ambient) * e;
  if (sunLight)     sunLight.intensity     = anim.from.sun + (anim.to.sun - anim.from.sun) * e;
  if (fillLight)    fillLight.intensity    = anim.from.fill + (anim.to.fill - anim.from.fill) * e;
  if (hemiLight)    hemiLight.intensity    = anim.from.hemi + (anim.to.hemi - anim.from.hemi) * e;
  zoneSpot.intensity = anim.from.zoneIntensity + (anim.to.zoneIntensity - anim.from.zoneIntensity) * e;
  renderer.toneMappingExposure = anim.from.exposure + (anim.to.exposure - anim.from.exposure) * e;

  sph.setFromVector3(camera.position.clone().sub(orbitTarget));

  if (t >= 1) {
    if (anim.onComplete) anim.onComplete();
    anim = null;
  }
}

// ── Enter zone ──
function enterZone(zoneId) {
  const zone = zonePresets[zoneId];
  if (!zone) return;
  currentZone = zoneId;

  zoneSpot.position.set(zone.spotTarget.x, 25, zone.spotTarget.z);
  zoneSpot.target.position.copy(zone.spotTarget);
  zoneSpot.angle = zone.spotAngle || PI/3.5;
  zoneSpot.distance = zone.spotAngle ? 55 : 45;

  startAnim(
    {
      cameraPos: camera.position.clone(),
      lookAt: orbitTarget.clone(),
      ambient: ambientLight ? ambientLight.intensity : 0.55,
      sun:     sunLight ? sunLight.intensity : 1.55,
      fill:    fillLight ? fillLight.intensity : 0.45,
      hemi:    hemiLight ? hemiLight.intensity : 0.65,
      zoneIntensity: zoneSpot.intensity,
      exposure: renderer.toneMappingExposure
    },
    {
      cameraPos: zone.cameraPos.clone(),
      lookAt:    zone.lookAt.clone(),
      ambient: 0.30,
      sun:     1.45,
      fill:    0.40,
      hemi:    0.48,
      zoneIntensity: 5.5,
      exposure: FOCUS_EXPOSURE
    },
    FOCUS_DURATION
  );

  const panel = document.getElementById('infoPanel');
  document.getElementById('infoTitle').textContent = zone.title;
  document.getElementById('infoText').textContent = zone.text;
  panel.style.display = 'block';
  setTimeout(() => { panel.style.opacity = '1'; }, 250);
}

// ── Reset to default overview ──
function resetView() {
  currentZone = null;
  startAnim(
    {
      cameraPos: camera.position.clone(),
      lookAt: orbitTarget.clone(),
      ambient: ambientLight ? ambientLight.intensity : 0.55,
      sun:     sunLight ? sunLight.intensity : 1.35,
      fill:    fillLight ? fillLight.intensity : 0.45,
      hemi:    hemiLight ? hemiLight.intensity : 0.55,
      zoneIntensity: zoneSpot.intensity,
      exposure: renderer.toneMappingExposure
    },
    {
      cameraPos: defaultCameraPos.clone(),
      lookAt:    defaultLookAt.clone(),
      ambient: originalLights.ambient,
      sun:     originalLights.sun,
      fill:    originalLights.fill,
      hemi:    originalLights.hemi,
      zoneIntensity: 0,
      exposure: BASE_EXPOSURE
    },
    FOCUS_DURATION
  );

  const panel = document.getElementById('infoPanel');
  panel.style.opacity = '0';
  setTimeout(() => { panel.style.display = 'none'; }, 300);
}

// ── Click detection ──
const raycaster = new THREE.Raycaster();
const mouseNDC = new THREE.Vector2();

let mouseDownPos = null;
canvas.addEventListener('pointerdown', (e) => {
  mouseDownPos = { x: e.clientX, y: e.clientY };
});
canvas.addEventListener('pointerup', (e) => {
  if (!mouseDownPos) return;
  const dx = e.clientX - mouseDownPos.x;
  const dy = e.clientY - mouseDownPos.y;
  const dragDist = Math.sqrt(dx*dx + dy*dy);
  mouseDownPos = null;

  if (dragDist > 5) return;

  mouseNDC.x = (e.clientX / innerWidth) * 2 - 1;
  mouseNDC.y = -(e.clientY / innerHeight) * 2 + 1;
  raycaster.setFromCamera(mouseNDC, camera);

  const floorPlane = new THREE.Plane(new THREE.Vector3(0,1,0), 0);
  const hitPoint = new THREE.Vector3();
  raycaster.ray.intersectPlane(floorPlane, hitPoint);
  if (!hitPoint) return;

  for (const zone of zoneHitZones) {
    if (hitPoint.distanceTo(zone.center) < zone.radius) {
      enterZone(zone.id);
      return;
    }
  }
});

// ── Hover cursor ──
canvas.addEventListener('pointermove', (e) => {
  if (mouseDownPos) return;

  mouseNDC.x = (e.clientX / innerWidth) * 2 - 1;
  mouseNDC.y = -(e.clientY / innerHeight) * 2 + 1;
  raycaster.setFromCamera(mouseNDC, camera);

  const floorPlane = new THREE.Plane(new THREE.Vector3(0,1,0), 0);
  const hitPoint = new THREE.Vector3();
  raycaster.ray.intersectPlane(floorPlane, hitPoint);
  if (!hitPoint) { canvas.style.cursor = 'default'; return; }

  let overZone = false;
  for (const zone of zoneHitZones) {
    if (hitPoint.distanceTo(zone.center) < zone.radius) {
      overZone = true;
      break;
    }
  }
  canvas.style.cursor = overZone ? 'pointer' : 'default';
});

// ── UI wiring ──
// (resetBtn wired globally)

// (writeup wired globally)

// Info panel close — fade lights back without moving camera
// (infoClose wired globally)

// ═══════════════════════════════════════════════════════
// RENDER LOOP
// ═══════════════════════════════════════════════════════
!function render(){
  requestAnimationFrame(render);
  updateAnim();
  renderer.render(scene, camera);
}();

return { enterZone, resetView };
})();

// ═════════════════════════════════════════════════════
// SHARED UI: floor nav, reset, info-panel close, writeup collapse
// ═════════════════════════════════════════════════════
(function(){
  const canvasGround = document.getElementById('canvas-ground');
  const canvasFirst  = document.getElementById('canvas-first');
  const overlay      = document.getElementById('fadeOverlay');
  const writeup      = document.getElementById('writeup');
  const writeupTitle = document.getElementById('writeupTitle');
  const writeupText  = document.getElementById('writeupText');
  const writeupHeader= document.getElementById('writeupHeader');
  const navPills     = document.querySelectorAll('.nav-pill');
  const resetBtn     = document.getElementById('resetBtn');
  const infoClose    = document.getElementById('infoClose');
  const infoPanel    = document.getElementById('infoPanel');

  let currentFloor = 'ground';

  const floorCopy = {
    ground: {
      title: 'Ground Floor · The Hub',
      text:  'Where arrival, waiting, dining and gathering happen. Four soft activity zones — karaoke, games, reading, yoga — orbit the Notes Tree, an anonymous message installation at the centre. A phygital community space designed for gradual social connection, not performance.'
    },
    first: {
      title: 'First Floor · The Active Space',
      text:  'A striped multi-sport turf for cricket, football, basketball and badminton, walled on three sides and netted on the fourth. A small snack bar handles quick refuels between sessions. Two bookable private rooms sit below — one event-flexible with an AV wall and bar, one soft and cozy for hangouts.'
    }
  };

  function apiFor(floor){ return floor === 'ground' ? gfAPI : ffAPI; }

  function switchFloor(target) {
    if (target === currentFloor) return;
    // 1. Curtain in
    overlay.classList.add('active');
    // 2. After curtain covers everything, swap canvases + writeup + reset new floor
    setTimeout(() => {
      // Reset the OUTGOING floor's camera/lights first so it's clean when returned to
      try { apiFor(currentFloor).resetView(); } catch(e){}
      // Hide info panel if open
      infoPanel.style.opacity = '0';
      setTimeout(() => { infoPanel.style.display = 'none'; }, 200);
      // Swap canvas visibility
      if (target === 'first') {
        canvasGround.classList.add('hidden');
        canvasFirst.classList.add('active');
      } else {
        canvasFirst.classList.remove('active');
        canvasGround.classList.remove('hidden');
      }
      // Update writeup copy + reopen it
      writeupTitle.textContent = floorCopy[target].title;
      writeupText.textContent  = floorCopy[target].text;
      writeup.classList.remove('collapsed');
      // Update active pill
      navPills.forEach(p => p.classList.toggle('active', p.dataset.floor === target));
      currentFloor = target;
      // 3. Curtain out
      setTimeout(() => overlay.classList.remove('active'), 60);
    }, 500);
  }

  navPills.forEach(pill => {
    pill.addEventListener('click', () => switchFloor(pill.dataset.floor));
  });

  // Global reset — dispatches to whichever floor is active
  resetBtn.addEventListener('click', () => {
    apiFor(currentFloor).resetView();
    writeup.classList.remove('collapsed');
  });

  // Global info close — matches ground floor's original close behavior
  infoClose.addEventListener('click', () => {
    infoPanel.style.opacity = '0';
    setTimeout(() => { infoPanel.style.display = 'none'; }, 300);
  });

  // Writeup collapse: header click + auto-collapse on canvas interaction
  writeupHeader.addEventListener('click', () => writeup.classList.toggle('collapsed'));
  const collapse = () => writeup.classList.add('collapsed');
  [canvasGround, canvasFirst].forEach(c => {
    c.addEventListener('pointerdown', collapse, { passive: true });
    c.addEventListener('wheel', collapse, { passive: true });
  });
})();
</script>
