// ── Label function ──
function makeLabel(text,x,y,z,parent,size){
  const c=document.createElement('canvas');
  const ctx=c.getContext('2d'); const s=4;
  c.width=320*s; c.height=56*s;
  const fs=(size||11)*s;
  ctx.font=`700 ${fs}px "Segoe UI",sans-serif`;
  const tw=ctx.measureText(text).width;
  const pad=14*s;
  const rx=(c.width-tw)/2-pad;
  const rw=tw+pad*2;
  ctx.fillStyle='rgba(30,22,60,0.85)';
  ctx.beginPath(); ctx.roundRect(rx,4*s,rw,48*s,10*s); ctx.fill();
  ctx.fillStyle='#FFFFFF';
  ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.fillText(text,c.width/2,c.height/2);
  const tex=new THREE.CanvasTexture(c); tex.minFilter=THREE.LinearFilter;
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:tex,transparent:true,depthTest:false}));
  sp.position.set(x,y,z); sp.scale.set(10,1.8,1);
  parent.add(sp); return sp;
}

