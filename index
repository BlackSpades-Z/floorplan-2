// ── Football goalposts — one at each end of the field ──
{
  const goalMat = ceramic(0xF0EBDE);   // white-ish painted metal
  const gnMat = new THREE.MeshStandardMaterial({
    color: 0x2E2A26, roughness: 0.9, metalness: 0.1,
    transparent: true, opacity: 0.28, side: THREE.DoubleSide
  });
  const gW = 4;      // goal width (spans z direction)
  const gH = 2.1;    // goal height
  const gD = 1.2;    // goal depth
  const goalZ = -19.8;   // centred on turf mid-z

  function buildGoal(gX, dir) {
    // dir = +1 → back extends +x (east goal, opening faces west)
    // dir = -1 → back extends -x (west goal, opening faces east)
    // Vertical posts on goal line (z ± gW/2)
    cyl(0.07, gH, goalMat, gX, turfTopY + gH/2, goalZ - gW/2, ff);
    cyl(0.07, gH, goalMat, gX, turfTopY + gH/2, goalZ + gW/2, ff);
    // Crossbar (runs in z direction)
    box(0.08, 0.08, gW + 0.05, goalMat, gX, turfTopY + gH, goalZ, ff);
    // Back diagonal supports (running down-back from top of each post)
    const diagLen = Math.sqrt(gH*gH + gD*gD);
    const tilt = Math.atan2(gD, gH);
    for (const zOff of [-gW/2, gW/2]) {
      const d = new THREE.Mesh(
        new THREE.CylinderGeometry(0.045, 0.045, diagLen, 8),
        goalMat
      );
      d.position.set(gX + dir * gD/2, turfTopY + gH/2, goalZ + zOff);
      d.rotation.z = dir * tilt;
      d.castShadow = true; ff.add(d);
    }
    // Back ground rail connecting the two diagonals at the floor
    box(0.05, 0.05, gW, goalMat, gX + dir * gD, turfTopY + 0.02, goalZ, ff);
    // Net — back, top, and two sides
    box(0.02, gH, gW, gnMat, gX + dir * gD, turfTopY + gH/2, goalZ, ff);   // back
    box(gD, gH, 0.02, gnMat, gX + dir * gD/2, turfTopY + gH/2, goalZ - gW/2, ff); // north side
    box(gD, gH, 0.02, gnMat, gX + dir * gD/2, turfTopY + gH/2, goalZ + gW/2, ff); // south side
    box(gD, 0.02, gW, gnMat, gX + dir * gD/2, turfTopY + gH, goalZ, ff);          // top
  }

  // West goal — opening faces east into the field
  buildGoal(L + WT + 0.6, -1);
  // East goal — opening faces west into the field
  buildGoal(R - WT - 0.6, +1);
}

