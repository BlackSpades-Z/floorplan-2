// ── Click detection ──
const raycaster = new THREE.Raycaster();
const mouseNDC = new THREE.Vector2();

let mouseDownPos = null;
canvas.addEventListener('pointerdown', (e) => {
  mouseDownPos = { x: e.clientX, y: e.clientY };
});
canvas.addEventListener('pointerup', (e) => {
  if (!mouseDownPos) return;
  const dx = e.clientX - mouseDownPos.x;
  const dy = e.clientY - mouseDownPos.y;
  const dragDist = Math.sqrt(dx*dx + dy*dy);
  mouseDownPos = null;

  // Only treat as click if minimal drag
  if (dragDist > 5) return;

  // Raycast onto floor plane at y=0
  mouseNDC.x = (e.clientX / innerWidth) * 2 - 1;
  mouseNDC.y = -(e.clientY / innerHeight) * 2 + 1;
  raycaster.setFromCamera(mouseNDC, camera);

  // Intersect with floor plane (y=0)
  const floorPlane = new THREE.Plane(new THREE.Vector3(0,1,0), 0);
  const hitPoint = new THREE.Vector3();
  raycaster.ray.intersectPlane(floorPlane, hitPoint);
  if (!hitPoint) return;

  // Check which zone (if any) the point falls into
  for (const zone of zoneHitZones) {
    const d = hitPoint.distanceTo(zone.center);
    if (d < zone.radius) {
      enterZone(zone.id);
      return;
    }
  }
});

// ── Hover detection (hand cursor over clickable zones) ──
canvas.addEventListener('pointermove', (e) => {
  // Only check hover when NOT actively dragging
  if (mouseDownPos) return;

  mouseNDC.x = (e.clientX / innerWidth) * 2 - 1;
  mouseNDC.y = -(e.clientY / innerHeight) * 2 + 1;
  raycaster.setFromCamera(mouseNDC, camera);

  const floorPlane = new THREE.Plane(new THREE.Vector3(0,1,0), 0);
  const hitPoint = new THREE.Vector3();
  raycaster.ray.intersectPlane(floorPlane, hitPoint);
  if (!hitPoint) { canvas.style.cursor = 'default'; return; }

  let overZone = false;
  for (const zone of zoneHitZones) {
    if (hitPoint.distanceTo(zone.center) < zone.radius) {
      overZone = true;
      break;
    }
  }
  canvas.style.cursor = overZone ? 'pointer' : 'default';
});

