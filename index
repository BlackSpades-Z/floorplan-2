// ═════════════════════════════════════════════════════════
// PUZZLE 3D at (-13, 21) — 4 large interlocking pieces on table
// ═════════════════════════════════════════════════════════
{
  const px = -13, pz = 21;
  // Table
  box(4.5, 0.5, 4.5, z2WoodDark, px, 0.25, pz, gf);
  // Table top
  box(4.3, 0.08, 4.3, z2Wood, px, 0.54, pz, gf);

  // Build a puzzle piece Shape
  // Each piece is a rectangle with nubs/indents on the sides that face other pieces
  // For a 2x2 puzzle: top-left, top-right, bottom-left, bottom-right
  // Sides facing inward have nubs, sides facing outward are straight
  //
  // Piece coords: pieceSize = 1.4, nubSize = 0.25
  const pieceSize = 1.4;
  const nub = 0.28;
  const pieceThickness = 0.15;

  function makePuzzlePiece(right, top) {
    // right = does this piece have a nub on its right side? (true for left column pieces)
    // top = does this piece have a nub on its top side? (true for bottom row pieces)
    // Otherwise it has an indent
    const s = pieceSize / 2;
    const shape = new THREE.Shape();
    // Start bottom-left
    shape.moveTo(-s, -s);

    // Bottom edge — has nub if top piece (bottom row pieces have flat bottom facing away)
    shape.lineTo(s, -s);

    // Right edge — with nub or indent based on `right` param
    if (right) {
      // Nub bulging OUT to the right (positive x)
      shape.lineTo(s, -nub/2);
      shape.bezierCurveTo(s + nub, -nub/2, s + nub, nub/2, s, nub/2);
      shape.lineTo(s, s);
    } else {
      // Indent going IN (negative x)
      shape.lineTo(s, -nub/2);
      shape.bezierCurveTo(s - nub, -nub/2, s - nub, nub/2, s, nub/2);
      shape.lineTo(s, s);
    }

    // Top edge — with nub or indent based on `top` param
    if (top) {
      // Nub bulging OUT upward (positive y)
      shape.lineTo(nub/2, s);
      shape.bezierCurveTo(nub/2, s + nub, -nub/2, s + nub, -nub/2, s);
      shape.lineTo(-s, s);
    } else {
      // Indent going IN downward
      shape.lineTo(nub/2, s);
      shape.bezierCurveTo(nub/2, s - nub, -nub/2, s - nub, -nub/2, s);
      shape.lineTo(-s, s);
    }

    // Left edge back to start
    shape.lineTo(-s, -s);

    return shape;
  }

  function addPuzzlePiece(offsetX, offsetZ, right, top, color) {
    const shape = makePuzzlePiece(right, top);
    const geo = new THREE.ExtrudeGeometry(shape, {
      depth: pieceThickness,
      bevelEnabled: true,
      bevelSize: 0.02,
      bevelThickness: 0.02,
      bevelSegments: 2,
      curveSegments: 12
    });
    const mat = clay(color);
    const mesh = new THREE.Mesh(geo, mat);
    // Rotate so it lies flat on the table (default extrude is +Z, we need +Y)
    mesh.rotation.x = -PI/2;
    mesh.position.set(px + offsetX, 0.6, pz + offsetZ);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    gf.add(mesh);
  }

  // Layout the 2x2 puzzle (viewed from top)
  // Piece coord system: x = right/left, z = forward/back on table
  // Half-size offsets so pieces touch at center
  const half = pieceSize / 2;

  // Top-left piece (green): needs nub on RIGHT (facing top-right), nub on BOTTOM (facing bottom-left)
  //   -> but our shape puts nubs on RIGHT and TOP, so we rotate 180° for TL
  // Simpler: just place 4 pieces with alternating nub patterns
  //
  // TL (green): right=true (nub out to right toward TR), top=false (indent toward TL's outer top)
  //   -> But TL outer top faces AWAY from other pieces. So top should be straight.
  //   Since our shape only has TOP and RIGHT as configurable (BOTTOM and LEFT are straight),
  //   we rotate the whole piece.
  //
  // For a 2x2 puzzle we need pieces oriented so their nubs/indents face each other:
  //   TL piece: bottom + right need to interlock; top + left are outer (straight)
  //   TR piece: bottom + left need to interlock; top + right are outer
  //   BL piece: top + right need to interlock; bottom + left are outer
  //   BR piece: top + left need to interlock; bottom + right are outer
  //
  // Our shape has straight bottom + left, configurable right + top.
  // So it matches BL directly. For others, rotate:
  //   TL: rotate 90° CW (so old top -> right (outer straight), old right -> bottom)  -- doesn't quite work
  //
  // Easier: build each piece separately with straight/nub/indent per side.

  // Rebuild with fully configurable piece
  function makePuzzlePieceFull(sides) {
    // sides = {top, right, bottom, left} each 'nub'|'indent'|'flat'
    const s = pieceSize / 2;
    const shape = new THREE.Shape();
    shape.moveTo(-s, -s);
    // Bottom edge (going right, from -s,-s to s,-s)
    if (sides.bottom === 'flat') {
      shape.lineTo(s, -s);
    } else {
      const dir = sides.bottom === 'nub' ? -1 : 1; // nub goes OUT (down = -y), indent goes IN (up = +y)
      shape.lineTo(-nub/2, -s);
      shape.bezierCurveTo(-nub/2, -s + dir*nub, nub/2, -s + dir*nub, nub/2, -s);
      shape.lineTo(s, -s);
    }
    // Right edge (going up, from s,-s to s,s)
    if (sides.right === 'flat') {
      shape.lineTo(s, s);
    } else {
      const dir = sides.right === 'nub' ? 1 : -1; // nub goes OUT (+x), indent goes IN (-x)
      shape.lineTo(s, -nub/2);
      shape.bezierCurveTo(s + dir*nub, -nub/2, s + dir*nub, nub/2, s, nub/2);
      shape.lineTo(s, s);
    }
    // Top edge (going left, from s,s to -s,s)
    if (sides.top === 'flat') {
      shape.lineTo(-s, s);
    } else {
      const dir = sides.top === 'nub' ? 1 : -1; // nub goes OUT (+y), indent goes IN (-y)
      shape.lineTo(nub/2, s);
      shape.bezierCurveTo(nub/2, s + dir*nub, -nub/2, s + dir*nub, -nub/2, s);
      shape.lineTo(-s, s);
    }
    // Left edge (going down, from -s,s to -s,-s)
    if (sides.left === 'flat') {
      shape.lineTo(-s, -s);
    } else {
      const dir = sides.left === 'nub' ? -1 : 1; // nub goes OUT (-x), indent goes IN (+x)
      shape.lineTo(-s, nub/2);
      shape.bezierCurveTo(-s + dir*nub, nub/2, -s + dir*nub, -nub/2, -s, -nub/2);
      shape.lineTo(-s, -s);
    }
    return shape;
  }

  function placePiece(offsetX, offsetZ, sides, color) {
    const shape = makePuzzlePieceFull(sides);
    const geo = new THREE.ExtrudeGeometry(shape, {
      depth: pieceThickness,
      bevelEnabled: true,
      bevelSize: 0.025,
      bevelThickness: 0.02,
      bevelSegments: 2,
      curveSegments: 12
    });
    const mesh = new THREE.Mesh(geo, clay(color));
    mesh.rotation.x = -PI/2;
    mesh.position.set(px + offsetX, 0.6 + pieceThickness, pz + offsetZ);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    gf.add(mesh);
  }

  // 2x2 layout — pieces interlock at center. In shape coords, +y = "top" of piece, -y = "bottom"
  // After rotation.x = -PI/2, shape's +y becomes -z (back of table), shape's -y becomes +z (front)
  //
  // Top-Left (green): outer sides (top+left) = flat, inner sides = right has nub, bottom has indent
  placePiece(-half, -half, {top:'flat', right:'nub', bottom:'indent', left:'flat'}, gGreen);
  // Top-Right (yellow): outer (top+right) = flat, inner: left has indent (matches TL's nub), bottom has nub
  placePiece( half, -half, {top:'flat', right:'flat', bottom:'nub', left:'indent'}, gYellow);
  // Bottom-Left (blue): outer (bottom+left) = flat, inner: right has indent, top has nub (matches TL's indent)
  placePiece(-half,  half, {top:'nub', right:'indent', bottom:'flat', left:'flat'}, gBlue);
  // Bottom-Right (red/pink): outer (bottom+right) = flat, inner: left has nub (matches BL's indent), top has indent (matches TR's nub)
  placePiece( half,  half, {top:'indent', right:'flat', bottom:'flat', left:'nub'}, gRed);

  // 2 chairs on long sides of table
  for (let s = -1; s <= 1; s += 2) {
    const cx = px + s*2.8, cz = pz;
    box(0.9, 0.1, 0.9, chairSeat, cx, 0.45, cz, gf);
    for(let lx3=-0.35;lx3<=0.35;lx3+=0.7) for(let lz3=-0.35;lz3<=0.35;lz3+=0.7)
      cyl(0.05, 0.4, metalMat, cx+lx3, 0.2, cz+lz3, gf);
    box(0.9, 0.6, 0.08, z2Wood, cx-s*0.4, 0.75, cz, gf);
  }
}
makeLabel('Puzzle', -13, WH+1, 21, gf);

// ═════════════════════════════════════════════════════════
// ARCHERY 3D at (-20, 26) — target STANDING VERTICALLY on tripod
// ═════════════════════════════════════════════════════════
{
  const ax = -20, az = 26;
  // Target board center height
  const boardY = 1.6;
  // The target face — rings stacked along X axis so they face outward (into the room, +x direction)
  // Rotate each cylinder so its flat face points +x (i.e., laid on its side)

  // Backing plate (largest, at back)
  const back = new THREE.Mesh(new THREE.CylinderGeometry(1.4, 1.4, 0.1, 24), ceramic(0xE8DFCE));
  back.rotation.z = PI/2; // rotate so flat face is now vertical
  back.position.set(ax, boardY, az);
  back.castShadow = true; back.receiveShadow = true;
  gf.add(back);

  // Outer muted red ring
  const r1 = new THREE.Mesh(new THREE.CylinderGeometry(1.4, 1.4, 0.05, 24), clay(gRed));
  r1.rotation.z = PI/2;
  r1.position.set(ax + 0.06, boardY, az);
  r1.castShadow = true; gf.add(r1);

  // Cream ring
  const r2 = new THREE.Mesh(new THREE.CylinderGeometry(1.0, 1.0, 0.06, 24), ceramic(0xEEE6D4));
  r2.rotation.z = PI/2;
  r2.position.set(ax + 0.09, boardY, az);
  r2.castShadow = true; gf.add(r2);

  // Inner muted red ring
  const r3 = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.6, 0.07, 24), clay(gRed));
  r3.rotation.z = PI/2;
  r3.position.set(ax + 0.12, boardY, az);
  r3.castShadow = true; gf.add(r3);

  // Muted yellow bullseye
  const bull = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 0.08, 20), ceramic(gYellow));
  bull.rotation.z = PI/2;
  bull.position.set(ax + 0.15, boardY, az);
  bull.castShadow = true; gf.add(bull);

  // Vertical support pole (from ground to back of target)
  cyl(0.08, boardY, z2WoodDark, ax - 0.1, boardY/2, az, gf);

  // A-FRAME STAND — two crossed legs behind the target forming an X
  // Both legs sit at the back of the target (x = ax - 0.1) and splay outward along z
  const standLegLen = boardY + 0.6;
  const standSplay = 1.0; // how far apart at the base
  const backX = ax - 0.1;
  // Left leg: top at (backX, boardY+0.1, az), bottom at (backX, 0, az - standSplay)
  {
    const dz = -standSplay;
    const dy = -(boardY + 0.1);
    const len = Math.sqrt(dz*dz + dy*dy);
    const leg = new THREE.Mesh(
      new THREE.CylinderGeometry(0.07, 0.07, len, 6),
      z2WoodDark
    );
    leg.position.set(backX, (boardY + 0.1)/2, az + dz/2);
    // Tilt around x-axis so it leans in the z direction
    leg.rotation.x = Math.atan2(dz, -dy);
    leg.castShadow = true; leg.receiveShadow = true;
    gf.add(leg);
  }
  // Right leg: top at (backX, boardY+0.1, az), bottom at (backX, 0, az + standSplay)
  {
    const dz = standSplay;
    const dy = -(boardY + 0.1);
    const len = Math.sqrt(dz*dz + dy*dy);
    const leg = new THREE.Mesh(
      new THREE.CylinderGeometry(0.07, 0.07, len, 6),
      z2WoodDark
    );
    leg.position.set(backX, (boardY + 0.1)/2, az + dz/2);
    leg.rotation.x = Math.atan2(dz, -dy);
    leg.castShadow = true; leg.receiveShadow = true;
    gf.add(leg);
  }
  // Small crossbar connecting the two legs at mid-height (makes the X shape)
  box(0.08, 0.08, standSplay * 0.8, z2WoodDark, backX, boardY * 0.4, az, gf);

  // Arrow stuck horizontally through the bullseye, sticking out toward +x (the shooter side)
  const arrow = new THREE.Mesh(
    new THREE.CylinderGeometry(0.03, 0.03, 1.2, 6),
    z2Wood
  );
  arrow.rotation.z = PI/2; // horizontal along x axis
  arrow.position.set(ax + 0.7, boardY, az); // tip in bullseye, tail out to +x
  arrow.castShadow = true;
  gf.add(arrow);
  // Red feathers at the tail (outer end)
  box(0.15, 0.15, 0.05, clay(0xB5715F), ax + 1.3, boardY + 0.1, az, gf);
  box(0.15, 0.15, 0.05, clay(0xB5715F), ax + 1.3, boardY - 0.1, az, gf);

  // ── ARCHER FIGURE (facing target, standing to the right at +x offset) ──
  const arch_x = ax + 4;  // 4 units away from target
  const arch_z = az;
  const skin = clay(0xD9B48A);
  const outfit = clay(0x8A7E70);

  // Head
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.22, 12, 10), skin);
  head.position.set(arch_x, 1.9, arch_z);
  head.castShadow = true; gf.add(head);

  // Torso
  box(0.5, 0.7, 0.3, outfit, arch_x, 1.35, arch_z, gf);

  // Legs (slight stance — one forward, one back)
  cyl(0.09, 0.9, outfit, arch_x, 0.55, arch_z - 0.15, gf);
  cyl(0.09, 0.9, outfit, arch_x, 0.55, arch_z + 0.15, gf);

  // Feet
  box(0.2, 0.08, 0.35, z2WoodDark, arch_x, 0.14, arch_z - 0.15, gf);
  box(0.2, 0.08, 0.35, z2WoodDark, arch_x, 0.14, arch_z + 0.15, gf);

  // Left arm (front, extended toward target — points -x direction)
  const bowArm = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.7, 8), skin);
  bowArm.rotation.z = PI/2;  // horizontal
  bowArm.position.set(arch_x - 0.45, 1.5, arch_z);
  bowArm.castShadow = true; gf.add(bowArm);

  // Right arm (bent back, pulling bowstring toward face)
  const drawArm = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.5, 8), skin);
  drawArm.rotation.z = PI/6;
  drawArm.position.set(arch_x + 0.05, 1.6, arch_z);
  drawArm.castShadow = true; gf.add(drawArm);

  // ── BOW ── vertical arc held in extended left hand
  // The bow stands upright (vertical), with its arc curving toward the archer (+x direction)
  // Bow center is at the extended hand position
  const bowCenterX = arch_x - 0.85;
  const bowCenterY = 1.5;
  const bowCenterZ = arch_z;
  const bowR = 0.55;    // bow radius (how far tips extend up/down from center)
  const bowThick = 0.045;
  const bowArcOpening = PI * 0.75; // how much of a circle the bow arc spans

  // Build the bow using a torus segment
  // TorusGeometry(radius, tube, radialSegments, tubularSegments, arc)
  const bowGeo = new THREE.TorusGeometry(bowR, bowThick, 6, 20, bowArcOpening);
  const bow = new THREE.Mesh(bowGeo, z2WoodDark);
  // Position bow so its center point is at bowCenter
  // Torus is in the XY plane by default (opens along Z)
  // We want it in the YZ plane (vertical, opening along +X toward archer)
  bow.position.set(bowCenterX, bowCenterY, bowCenterZ);
  // Rotate so the arc opens toward the archer (+X direction)
  // Default torus: arc spans from angle 0 to bowArcOpening in XY plane
  // We need it upright (in YZ plane) with the arc curving AWAY from archer (concave side toward archer)
  bow.rotation.y = PI/2; // put torus in YZ plane
  bow.rotation.x = -bowArcOpening/2 - PI/2; // rotate so arc midpoint faces -x (toward target)
  bow.castShadow = true; gf.add(bow);

  // Bowstring: straight vertical line from top tip to bottom tip of bow, pulled back at middle
  // Bow tips are at bowCenter ± (bowR * sin/cos of arc endpoints)
  // With our rotation, tips are approximately at (bowCenterX, bowCenterY ± bowR*sin(arcOpen/2), bowCenterZ)
  const tipUpY = bowCenterY + bowR * Math.sin(bowArcOpening/2);
  const tipDownY = bowCenterY - bowR * Math.sin(bowArcOpening/2);
  const pullX = arch_x + 0.05;  // where archer's drawing hand pulls string back to
  const pullY = 1.6;
  const stringMat = clay(0x2A2A2A);

  // Top string segment: from top bow tip to pull point
  {
    const x1 = bowCenterX, y1 = tipUpY, z1 = bowCenterZ;
    const x2 = pullX,      y2 = pullY,  z2 = bowCenterZ;
    const dx = x2-x1, dy = y2-y1, dz = z2-z1;
    const len = Math.sqrt(dx*dx + dy*dy + dz*dz);
    const s = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.012, len, 4), stringMat);
    s.position.set((x1+x2)/2, (y1+y2)/2, (z1+z2)/2);
    // Align cylinder along the vector from tip to pull point
    // Cylinder defaults along +Y, rotate so it matches direction
    const angle = Math.atan2(dx, dy);
    s.rotation.z = -angle;
    s.castShadow = true; gf.add(s);
  }
  // Bottom string segment: from bottom bow tip to pull point
  {
    const x1 = bowCenterX, y1 = tipDownY, z1 = bowCenterZ;
    const x2 = pullX,      y2 = pullY,    z2 = bowCenterZ;
    const dx = x2-x1, dy = y2-y1, dz = z2-z1;
    const len = Math.sqrt(dx*dx + dy*dy + dz*dz);
    const s = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.012, len, 4), stringMat);
    s.position.set((x1+x2)/2, (y1+y2)/2, (z1+z2)/2);
    const angle = Math.atan2(dx, dy);
    s.rotation.z = -angle;
    s.castShadow = true; gf.add(s);
  }

  // Arrow: horizontal, resting on the bow at middle height, pointing toward target (-x)
  // Nocked at pull point, tip extending forward past the bow
  const arrowLen = 1.2;
  const arrowTailX = pullX;
  const arrowTipX = arrowTailX - arrowLen;
  const readyArrow = new THREE.Mesh(
    new THREE.CylinderGeometry(0.025, 0.025, arrowLen, 6),
    z2Wood
  );
  readyArrow.rotation.z = PI/2;
  readyArrow.position.set((arrowTailX + arrowTipX)/2, 1.55, arch_z);
  readyArrow.castShadow = true;
  gf.add(readyArrow);

  // Arrowhead (small pointed tip)
  const head_arrow = new THREE.Mesh(
    new THREE.ConeGeometry(0.05, 0.15, 6),
    z2Metal
  );
  head_arrow.rotation.z = PI/2;
  head_arrow.position.set(arrowTipX - 0.08, 1.55, arch_z);
  head_arrow.castShadow = true;
  gf.add(head_arrow);

  // Feathers at the tail (small colored fins)
  box(0.1, 0.12, 0.04, clay(0xB5715F), arrowTailX - 0.05, 1.65, arch_z, gf);
  box(0.1, 0.12, 0.04, clay(0xB5715F), arrowTailX - 0.05, 1.45, arch_z, gf);
}
