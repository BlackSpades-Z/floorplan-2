  zoneSpot.position.set(zone.spotTarget.x, 25, zone.spotTarget.z);
  zoneSpot.target.position.copy(zone.spotTarget);
  // Bigger zones (foodcourt) get a wider soft light
  zoneSpot.angle = zone.spotAngle || PI/3.5;
  zoneSpot.distance = zone.spotAngle ? 55 : 45;

