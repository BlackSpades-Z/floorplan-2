// ── Animation state ──
let anim = null;
let currentZone = null;

function easeInOutCubic(t) {
  // Retained name; now a quintic ease — heavier settle for architectural-walkthrough pacing.
  return t < 0.5 ? 16*t*t*t*t*t : 1 - Math.pow(-2*t + 2, 5)/2;
}

function startAnim(from, to, duration, onComplete) {
  anim = {
    start: performance.now(),
    duration: duration,
    from: from,
    to: to,
    onComplete: onComplete
  };
}

function updateAnim() {
  if (!anim) return;
  const now = performance.now();
  const t = Math.min(1, (now - anim.start) / anim.duration);
  const e = easeInOutCubic(t);

  camera.position.lerpVectors(anim.from.cameraPos, anim.to.cameraPos, e);
  orbitTarget.lerpVectors(anim.from.lookAt, anim.to.lookAt, e);
  camera.lookAt(orbitTarget);

  if (ambientLight) ambientLight.intensity = anim.from.ambient + (anim.to.ambient - anim.from.ambient) * e;
  if (sunLight)     sunLight.intensity     = anim.from.sun + (anim.to.sun - anim.from.sun) * e;
  if (fillLight)    fillLight.intensity    = anim.from.fill + (anim.to.fill - anim.from.fill) * e;
  if (hemiLight)    hemiLight.intensity    = anim.from.hemi + (anim.to.hemi - anim.from.hemi) * e;
  zoneSpot.intensity = anim.from.zoneIntensity + (anim.to.zoneIntensity - anim.from.zoneIntensity) * e;
  renderer.toneMappingExposure = anim.from.exposure + (anim.to.exposure - anim.from.exposure) * e;

  sph.setFromVector3(camera.position.clone().sub(orbitTarget));

  if (t >= 1) {
    if (anim.onComplete) anim.onComplete();
    anim = null;
  }
}

